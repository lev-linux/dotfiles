#!/bin/sh
exec >/dev/null 2>&1

xrandr --setprovideroutputsource nvidia iGPU
# layouts live in ~/.config/autorandr (docked, projector, default)
autorandr --change --default default
xrandr --dpi 100
# re-run autorandr on hotplug (udev gets no events from the NVIDIA HDMI port)
"$HOME/.local/bin/autorandr-watch" &

# syncthing --no-browser &
# kmonad ~/.config/kmonad.kbd &
scrond -f ~/.config/cron/crontab

xset b off
pipewire &
exec dbus-run-session -- dwm
